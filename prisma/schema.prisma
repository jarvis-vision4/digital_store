generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MODERATOR
  CUSTOMER
}

enum OrderStatus {
  Pending
  Success
  Cancelled
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  REFERRAL_BONUS
  ORDER_SPEND
  REFUND
}

enum WalletTransactionStatus {
  Pending
  Success
  Cancelled
}

enum CouponStatus {
  Active
  Redeemed
}

enum ReferralStatus {
  Pending
  Rewarded
}

model User {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username       String    @unique @db.VarChar(100)
  email          String?   @unique @db.VarChar(150)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  walletBalance  Decimal   @default(0.00) @map("wallet_balance") @db.Decimal(15, 2)
  telegramChatId String?   @unique @map("telegram_chat_id") @db.VarChar(100)
  referralCode   String    @unique @map("referral_code") @db.VarChar(50)
  referredBy     String?   @map("referred_by") @db.VarChar(50)
  vipLevel       Int       @default(0) @map("vip_level")
  vipName        String    @default("Standard Gamer") @map("vip_name") @db.VarChar(50)
  discountRate   Decimal   @default(0.0000) @map("discount_rate") @db.Decimal(5, 4)
  role           UserRole  @default(CUSTOMER)
  isActive       Boolean   @default(true) @map("is_active")
  rememberToken  String?   @map("remember_token") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  orders           Order[]
  walletTransactions WalletTransaction[]
  couponsRedeemed  Coupon[]     @relation("RedeemedCoupons")
  referralsGiven   Referral[]     @relation("Referrer")
  referralsReceived Referral[]    @relation("Referee")
  digitalOrders    DigitalOrder[]
  auditLogs        AuditLog[]
  chatMessages     ChatMessage[]

  @@index([referralCode])
  @@index([telegramChatId])
  @@map("users")
}

model DigitalProduct {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(200)
  category    String   @default("Gift Card") @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  priceMmk    Decimal  @map("price_mmk") @db.Decimal(12, 2)
  rating      Decimal  @default(0) @db.Decimal(3, 1)
  salesCount  Int      @default(0) @map("sales_count")
  badge       String?  @db.VarChar(50)
  isAvailable Boolean  @default(true) @map("is_available")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  digitalOrders    DigitalOrder[]
  variants         DigitalProductVariant[]
  features         DigitalProductFeature[]

  @@map("digital_products")
}

model DigitalProductVariant {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  digitalProductId BigInt  @map("digital_product_id") @db.UnsignedBigInt
  name            String   @db.VarChar(200)
  durationDays    Int      @map("duration_days")
  priceMmk        Decimal  @map("price_mmk") @db.Decimal(12, 2)
  priceUsd        Decimal? @map("price_usd") @db.Decimal(10, 2)
  badge           String?  @db.VarChar(50)
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)
  digitalOrders  DigitalOrder[]

  @@index([digitalProductId])
  @@map("digital_product_variants")
}

model DigitalProductFeature {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  digitalProductId BigInt  @map("digital_product_id") @db.UnsignedBigInt
  name            String   @db.VarChar(200)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  digitalProduct DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@index([digitalProductId])
  @@map("digital_product_features")
}

model DigitalOrder {
  id                    String          @id @db.VarChar(100)
  userId                BigInt          @map("user_id") @db.UnsignedBigInt
  digitalProductId      BigInt          @map("digital_product_id") @db.UnsignedBigInt
  digitalProductVariantId BigInt?       @map("digital_product_variant_id") @db.UnsignedBigInt
  productName           String          @map("product_name") @db.VarChar(200)
  variantName           String?         @map("variant_name") @db.VarChar(200)
  amountMmk             Decimal         @map("amount_mmk") @db.Decimal(12, 2)
  status                OrderStatus     @default(Pending)
  deliveryContent       String?         @map("delivery_content") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  digitalProduct     DigitalProduct        @relation(fields: [digitalProductId], references: [id])
  digitalProductVariant DigitalProductVariant? @relation(fields: [digitalProductVariantId], references: [id])

  @@index([status])
  @@map("digital_orders")
}

model Order {
  id          String       @id @db.VarChar(100)
  userId      BigInt       @map("user_id") @db.UnsignedBigInt
  gameId      String?      @map("game_id") @db.VarChar(50)
  gameName    String       @map("game_name") @db.VarChar(150)
  packageName String       @map("package_name") @db.VarChar(200)
  amountMmk         Decimal      @map("amount_mmk") @db.Decimal(12, 2)
  playerId          String?      @map("player_id") @db.VarChar(100)
  zoneId            String?      @map("zone_id") @db.VarChar(50)
  status            OrderStatus  @default(Pending)
  deliveryContent   String?      @map("delivery_content") @db.Text
  rating            Int?
  reviewText        String?      @map("review_text") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("orders")
}

model WalletTransaction {
  id              String                   @id @db.VarChar(100)
  userId          BigInt                   @map("user_id") @db.UnsignedBigInt
  amount          Decimal                  @db.Decimal(15, 2)
  type            WalletTransactionType
  paymentMethod   String                   @map("payment_method") @db.VarChar(100)
  phone           String                   @db.VarChar(50)
  screenshotUrl   String?                  @map("screenshot_url") @db.LongText
  status          WalletTransactionStatus  @default(Pending)
  transactionId   String?                  @map("transaction_id") @db.VarChar(100)
  rejectionReason String?                  @map("rejection_reason") @db.VarChar(255)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@map("wallet_transactions")
}

model Coupon {
  code       String       @id @db.VarChar(50)
  amount     Decimal      @db.Decimal(12, 2)
  createdBy  String       @map("created_by") @db.VarChar(100)
  redeemedBy BigInt?      @map("redeemed_by") @db.UnsignedBigInt
  status     CouponStatus @default(Active)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  redeemedByUser User? @relation("RedeemedCoupons", fields: [redeemedBy], references: [id], onDelete: SetNull)

  @@map("coupons")
}

model Referral {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  referrerId     BigInt          @map("referrer_id") @db.UnsignedBigInt
  refereeId      BigInt          @unique @map("referee_id") @db.UnsignedBigInt
  bonusAmountMmk Decimal         @default(500.00) @map("bonus_amount_mmk") @db.Decimal(12, 2)
  status         ReferralStatus  @default(Pending)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model PromotionalBanner {
  id          String   @id @db.VarChar(50)
  imageUrl    String   @map("image_url") @db.Text
  title       String   @db.VarChar(200)
  description String?  @db.Text
  badge       String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("promotional_banners")
}

model SystemSetting {
  settingKey   String   @id @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  action    String   @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model ChatMessage {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  senderRole    UserRole  @map("sender_role")
  content       String    @db.Text
  readByUserAt  DateTime? @map("read_by_user_at")
  readByAdminAt DateTime? @map("read_by_admin_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}
